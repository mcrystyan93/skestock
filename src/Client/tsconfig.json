/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@ske/models": ["./src/app/core/models"],
      "@ske/theme": ["./src/app/core/theme"],
      "@ske/auth": ["./src/app/core/auth"],
      "@ske/layouts": ["./src/app/core/layouts"],
      "@ske/layouts/menu-toggle": ["./src/app/core/layouts/full/menu-toggle/menu-toggle.ts"],
      "@ske/signalr": ["./src/app/core/signalr"],
      "@ske/routes": ["./src/app/core/routes"],
      "@ske/shared/errors": ["./src/app/shared/errors"],
      "@ske/shared/loader": ["./src/app/shared/loader"],
      "@ske/features/login": ["./src/app/features/login"],
      "@ske/features/categories": ["./src/app/features/categories"],
      "@ske/features/items": ["./src/app/features/items"],
      "@ske/shared/theme": ["./src/app/shared/theme"],
      "@ske/shared/categories": ["./src/app/shared/categories"],
      "@ske/shared/tables": ["./src/app/shared/tables"],
      "@ske/shared/items": ["./src/app/shared/items"],
      "@ske/shared/school-classes": ["./src/app/shared/school-classes"],
      "@ske/features/school-classes": ["./src/app/features/school-classes"],
      "@ske/shared/goods-receipts": ["./src/app/shared/goods-receipts"],
      "@ske/shared/goods-receipt-imports": ["./src/app/shared/goods-receipt-imports"],
      "@ske/shared/order-lists": ["./src/app/shared/order-lists"],
      "@ske/shared/order-lists/services": ["./src/app/shared/order-lists/services/index.ts"],
      "@ske/shared/supply-lists": ["./src/app/shared/supply-lists"],
      "@ske/shared/stock-batches": ["./src/app/shared/stock-batches"],
      "@ske/shared/stock": ["./src/app/shared/stock"],
      "@ske/shared/class-statistics": ["./src/app/shared/class-statistics"],
      "@ske/shared/locations": ["./src/app/shared/locations"],
      "@ske/shared/icons": ["./src/app/shared/icons"],
      "@ske/shared/storage": ["./src/app/shared/storage"],
      "@ske/shared/directives": ["./src/app/shared/ui/directives"],
      "@ske/shared/header-tabs": ["./src/app/shared/ui/header-tabs"],
      "@ske/shared/pipes": ["./src/app/shared/ui/pipes"],
      "@ske/shared/virtual-scroll": ["./src/app/shared/ui/virtual-scroll"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
