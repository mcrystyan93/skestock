{
  "name": "ske",
  "version": "0.0.0",
  "scripts": {
    "dev": "ng serve",
    "ng": "ng",
    "generate:icons": "node scripts/generate-icon-catalog.mjs",
    "prebuild": "npm run generate:icons",
    "start": "run-script-os",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "apexcharts": "^7.6.1",
    "lodash-es": "^4.18.1",
    "ng-apexcharts": "^3.1.0",
    "ng-zorro-antd": "^22.1.1",
    "run-script-os": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.0",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
