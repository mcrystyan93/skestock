[Unit]
Description=skestock background worker
Requires=skestock-db.service skestock-cache.service skestock-storage.service
# Wants (not Requires): telemetry being unavailable must never stop the application.
Wants=skestock-dashboard.service
After=skestock-db.service skestock-cache.service skestock-storage.service skestock-dashboard.service

[Container]
ContainerName=skestock-worker
Image=localhost/skestock-worker:current
Network=skestock.network
EnvironmentFile=%h/.config/skestock/production.env
Environment=OTEL_SERVICE_NAME=worker

[Service]
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
