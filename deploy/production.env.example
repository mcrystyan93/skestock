# This file documents the runtime contract. The workflow renders the real file
# from GitHub Environment variables and secrets and uploads it to Fedora.
SKESTOCK_IMAGE_TAG=sha-example
SKESTOCK_WEB_IMAGE=ghcr.io/mcrystyan93/skestock-web:sha-example
SKESTOCK_WORKER_IMAGE=ghcr.io/mcrystyan93/skestock-worker:sha-example
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=replace-with-a-github-environment-secret
REDIS_PASSWORD=replace-with-a-github-environment-secret
OpenApiSettings__ApiKey=replace-with-a-github-environment-secret
OpenApiSettings__Model=gpt-5.6-luna
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
DataProtection__KeysDirectory=/var/lib/skestock/data-protection-keys
ConnectionStrings__skestockDb=Server=dbserver,1433;User ID=sa;Password=replace-me;TrustServerCertificate=true;Initial Catalog=skestockDb
ConnectionStrings__skestock-cache=skestock-cache:6379,password=replace-me
ConnectionStrings__blobservice=replace-with-rendered-azurite-blob-connection-string
ConnectionStrings__queues=replace-with-rendered-azurite-queue-connection-string
Cors__AllowedOrigins__0=http://mini-pc.example
